# Optional: copy this file to .env to change the AI provider.

# Which AI to use:
#   claude-code (default) — your Claude subscription via the installed `claude` CLI, no key needed
#   gemini (free key) | groq (free key) | ollama (free, runs on your PC) | anthropic (paid API key)
AI_PROVIDER=claude-code

# claude-code: path to the CLI if `claude` isn't on PATH
# CLAUDE_PATH=

# Gemini — free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — free key: https://console.groq.com/keys
# GROQ_API_KEY=

# Ollama — no key. Install https://ollama.com then run: ollama pull gemma3
# OLLAMA_HOST=http://localhost:11434

# Claude (paid) — https://console.anthropic.com
# ANTHROPIC_API_KEY=

# Live audio (optional)
# GHOST_MIC=MCHOSE           # use the mic whose name contains this (default: your headset's mic, else Windows default)
# GHOST_VOCAB=display, overlay, Electron   # words speech-to-text should expect
# WHISPER_MODEL_ME=small.en  # your mic: accurate model (default when installed)
# WHISPER_MODEL_THEM=base.en # other people: fast model (keeps suggestions quick)

# Optional
# GHOST_MODEL=        # force a specific model; otherwise the newest suitable one is picked
# GHOST_STEALTH=0     # start with stealth off (overlay visible in screenshots)
